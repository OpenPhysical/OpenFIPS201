<?xml version="1.0" encoding="UTF-8"?>
<project name="OpenFIPS201 PIV Applet" xmlns:ivy="antlib:org.apache.ivy.ant" xmlns:jacoco="antlib:org.jacoco.ant" default="all" basedir="..">

  <property name="VERSION_MAJOR" value="1"/>
  <property name="VERSION_MINOR" value="10"/>
  <property name="VERSION_REVISION" value="openphy-r1"/>
  <property name="SDK_BASE" value="tools/sdk"/>
  <property name="BUILD_SDK" value="${SDK_BASE}/jc310"/>
  <property name="TARGET_SDK" value="3.0.5"/>
  <property name="vci.suite" value="CS2"/>
  <property name="attestation.enabled" value="true"/>

  <!-- Use class-only GP API jar by default for JDK11+ compatibility. -->
  <property name="gp.version" value="gp211"/>

  <property name="jc.home" value="${BUILD_SDK}"/>
  <property name="gp.home" value="${basedir}/tools/sdk/${gp.version}"/>
  <property name="gp.exportjar" value="${gp.home}/${gp.version}.jar"/>
  
  <property name="build.version" value="${VERSION_MAJOR}.${VERSION_MINOR}"/>
  <property name="applet.sourcepath" value="src/com/makina/security/openfips201"/>
  <property name="build.sourcepath" value="build/preprocessed-src/com/makina/security/openfips201"/>
  <property name="build.outputpath" value="build/bin"/>
  <property name="build.outputfile" value="OpenFIPS201-v${VERSION_MAJOR}_${VERSION_MINOR}_${VERSION_REVISION}.cap"/>
  <property name="build.outputfile_debug" value="OpenFIPS201-v${VERSION_MAJOR}_${VERSION_MINOR}_${VERSION_REVISION}-DEBUG.cap"/>
  <property name="docs.outputpath" value="build/docs"/>
  <property name="docs.classpath" value="${BUILD_SDK}/lib/api_classic-3.0.5.jar;${gp.exportjar}"/>
  <property name="test.sourcepath" value="src/dev/mistial/tests"/>
  <property name="tool.sourcepath" value="src/dev/mistial/tools"/>
  <property name="tool.test.sourcepath" value="src/dev/mistial/tool-tests"/>
  <property name="test.outputpath" value="build/test-bin"/>
  <property name="tool.outputpath" value="build/tool-bin"/>
  <property name="test.reportpath" value="build/test-reports"/>
  <property name="coverage.outputpath" value="build/coverage"/>
  <property name="coverage.execfile" value="${coverage.outputpath}/jacoco.exec"/>
  <property name="coverage.xmlfile" value="${coverage.outputpath}/jacoco.xml"/>
  <property name="coverage.htmlpath" value="${coverage.outputpath}/html"/>
  <property name="coverage.instrumented" value="${coverage.outputpath}/instrumented"/>
  <property name="coverage.minimum.openfips201.line" value="0.55"/>
  <property name="deps.outputpath" value="build/lib"/>
  <property name="jpp.sourcepath" value="build/vendor/jpp/src/main/java"/>
  <property name="jpp.antpath" value="build/vendor/jpp/src/main/ant"/>
  <property name="jpp.outputpath" value="build/jpp-bin"/>
  <property name="jpp.jar" value="build/jpp.jar"/>
  <property name="ivy.version" value="2.5.3"/>
  <property name="ivy.bootstrap.dir" value="build/ivy"/>
  <property name="ivy.default.ivy.user.dir" location="build/ivy2"/>
  <property name="ivy.jar" value="${ivy.bootstrap.dir}/ivy-${ivy.version}.jar"/>
  <property name="ivy.settings.file" value="build/ivysettings.xml"/>
  <property name="ivy.module.file" value="build/ivy.xml"/>

  <path id="test.compile.classpath">
    <pathelement location="${BUILD_SDK}/lib/api_classic-3.0.5.jar"/>
    <pathelement location="${gp.exportjar}"/>
    <pathelement location="tools/jcard-v26.07.13.jar"/>
    <fileset dir="${deps.outputpath}">
      <include name="*.jar"/>
    </fileset>
  </path>

  <!-- NOTE: this path doubles as the tool runtime classpath. The SDK/GP export stub jars
       must never appear here (see the test.runtime.classpath note above); the applet
       sources are compiled against the stubs in a dedicated step inside tool-compile. -->
  <path id="tool.compile.classpath">
    <pathelement location="tools/jcard-v26.07.13.jar"/>
    <fileset dir="${deps.outputpath}">
      <include name="*.jar"/>
    </fileset>
  </path>

  <path id="tool.runtime.classpath">
    <pathelement location="${tool.outputpath}"/>
    <path refid="tool.compile.classpath"/>
  </path>

  <!-- NOTE: ${gp.exportjar} must stay OFF the test runtime classpath. It contains
       compile-time stubs (e.g. GPSystem.getSecureChannel() returns null) that shadow
       jCardEngine's functional org.globalplatform implementation and break any test
       that drives the applet's GlobalPlatform secure-channel path. -->
  <path id="test.runtime.classpath">
    <pathelement location="${test.outputpath}"/>
    <pathelement location="${tool.outputpath}"/>
    <pathelement location="tools/jcard-v26.07.13.jar"/>
    <fileset dir="${deps.outputpath}">
      <include name="*.jar"/>
    </fileset>
  </path>
  <path id="jacoco.ant.classpath">
    <fileset dir="${deps.outputpath}">
      <include name="org.jacoco.ant-*.jar"/>
      <include name="org.jacoco.core-*.jar"/>
      <include name="org.jacoco.report-*.jar"/>
      <include name="org.jacoco.agent-*.jar"/>
      <include name="asm-*.jar"/>
    </fileset>
  </path>

  <target name="bootstrap-ivy">
    <mkdir dir="${ivy.bootstrap.dir}" />
    <get src="https://repo1.maven.org/maven2/org/apache/ivy/ivy/${ivy.version}/ivy-${ivy.version}.jar"
         dest="${ivy.jar}"
         skipexisting="true" />
  </target>

  <target name="resolve-test-deps" depends="bootstrap-ivy">
    <mkdir dir="${deps.outputpath}" />
    <taskdef uri="antlib:org.apache.ivy.ant"
             resource="org/apache/ivy/ant/antlib.xml"
             classpath="${ivy.jar}" />
    <ivy:settings id="openfips201.ivy.settings" file="${ivy.settings.file}" />
    <ivy:resolve file="${ivy.module.file}" settingsRef="openfips201.ivy.settings" />
    <ivy:retrieve pattern="${deps.outputpath}/[artifact]-[revision].[ext]"
                  conf="test-compile,test-runtime,tool-compile,tool-runtime"
                  sync="true"
                  settingsRef="openfips201.ivy.settings" />
  </target>

  <target name="clean">
    <delete dir="${build.outputpath}"/>
    <delete dir="build/preprocessed-src"/>
    <delete dir="${docs.outputpath}"/>
    <delete dir="${test.outputpath}"/>
    <delete dir="${tool.outputpath}"/>
    <delete dir="${test.reportpath}"/>
    <delete dir="${coverage.outputpath}"/>
  </target>

  <target name="jpp-build">
    <delete dir="${jpp.outputpath}"/>
    <mkdir dir="${jpp.outputpath}"/>
    <javac srcdir="${jpp.sourcepath}" destdir="${jpp.outputpath}" source="1.8" target="1.8" includeantruntime="true" encoding="UTF-8">
      <compilerarg value="-Xlint:-options"/>
    </javac>
    <jar destfile="${jpp.jar}">
      <fileset dir="${jpp.outputpath}"/>
      <fileset dir="${jpp.antpath}"/>
    </jar>
  </target>

  <target name="configure-vci-suite">
    <condition property="VCI_CS2" value="true">
      <equals arg1="${vci.suite}" arg2="CS2"/>
    </condition>
    <condition property="VCI_CS7" value="true">
      <equals arg1="${vci.suite}" arg2="CS7"/>
    </condition>
  </target>

  <target name="configure-attestation">
    <condition property="ATTESTATION_ENABLED" value="true">
      <equals arg1="${attestation.enabled}" arg2="true"/>
    </condition>
  </target>

  <target name="preprocess-applet" depends="jpp-build,configure-vci-suite,configure-attestation">
    <fail message="vci.suite must be CS2 or CS7, got '${vci.suite}'">
      <condition>
        <and>
          <not><equals arg1="${vci.suite}" arg2="CS2"/></not>
          <not><equals arg1="${vci.suite}" arg2="CS7"/></not>
        </and>
      </condition>
    </fail>
    <fail message="attestation.enabled must be true or false, got '${attestation.enabled}'">
      <condition>
        <and>
          <not><equals arg1="${attestation.enabled}" arg2="true"/></not>
          <not><equals arg1="${attestation.enabled}" arg2="false"/></not>
        </and>
      </condition>
    </fail>
    <delete dir="build/preprocessed-src"/>
    <mkdir dir="${build.sourcepath}"/>
    <taskdef resource="jpp.xml" classpath="${jpp.jar}"/>
    <jpp destdir="${build.sourcepath}" force="true" readonly="false" verbose="false">
      <fileset dir="${applet.sourcepath}" includes="**/*.java"/>
    </jpp>
  </target>

  <target name="compile" depends="clean,compile-cap"/>

  <target name="compile-cap" depends="preprocess-applet">
    <mkdir dir="${build.outputpath}" />
    <taskdef name="javacard" classname="pro.javacard.ant.JavaCard" classpath="tools/ant-javacard.jar"/>
    <javacard>
      <cap targetsdk="${TARGET_SDK}" aid="A00000030800001000" output="${build.outputpath}/${build.outputfile}" sources="${build.sourcepath}" version="${build.version}">
        <applet class="com.makina.security.openfips201.OpenFIPS201" aid="A000000308000010000100"/>
        <import exps="${gp.home}" jar="${gp.exportjar}"/>
      </cap>
      <cap targetsdk="${TARGET_SDK}" aid="A00000030800001000" output="${build.outputpath}/${build.outputfile_debug}" sources="${build.sourcepath}" version="${build.version}">
        <applet class="com.makina.security.openfips201.OpenFIPS201" aid="A000000308000010000100"/>
        <import exps="${gp.home}" jar="${gp.exportjar}"/>
      </cap>
    </javacard>
  </target>

  <target name="doc" depends="compile">
    <mkdir dir="${docs.outputpath}" />
    <javadoc access="private" packagenames="src" sourcepath="${build.sourcepath}" destdir="${docs.outputpath}" classpath="${docs.classpath}" linksource="yes">
      <fileset dir="${build.sourcepath}">
        <include name="**" />
      </fileset>
    </javadoc>
  </target>

  <target name="test-compile" depends="resolve-test-deps,tool-compile,preprocess-applet">
    <delete dir="${test.outputpath}" />
    <mkdir dir="${test.outputpath}" />

    <javac srcdir="${build.sourcepath}" destdir="${test.outputpath}" source="1.8" target="1.8" debug="true" includeantruntime="false" encoding="windows-1252">
      <classpath refid="test.compile.classpath"/>
    </javac>

    <javac srcdir="${test.sourcepath}" destdir="${test.outputpath}" source="1.8" target="1.8" includeantruntime="false" encoding="windows-1252">
      <exclude name="com/makina/security/openfips201/PIVAttestationDerValidationTest.java"
               unless="ATTESTATION_ENABLED"/>
      <classpath>
        <path refid="test.compile.classpath"/>
        <pathelement location="${tool.outputpath}"/>
        <pathelement location="${test.outputpath}"/>
      </classpath>
    </javac>

    <javac srcdir="${tool.test.sourcepath}" destdir="${test.outputpath}" source="1.8" target="1.8" includeantruntime="false" encoding="windows-1252">
      <classpath>
        <path refid="test.compile.classpath"/>
        <pathelement location="${tool.outputpath}"/>
        <pathelement location="${test.outputpath}"/>
      </classpath>
    </javac>
  </target>

  <target name="tool-compile" depends="resolve-test-deps,preprocess-applet">
    <delete dir="${tool.outputpath}" />
    <mkdir dir="${tool.outputpath}" />
    <!-- The emulator server tool installs the applet class into jCardEngine, so the applet
         is compiled into the tool output as well. Compilation uses the SDK/GP stub jars,
         which stay confined to this step and off the tool runtime classpath. -->
    <javac srcdir="${build.sourcepath}" destdir="${tool.outputpath}" source="1.8" target="1.8" includeantruntime="false" encoding="windows-1252">
      <classpath>
        <pathelement location="${BUILD_SDK}/lib/api_classic-3.0.5.jar"/>
        <pathelement location="${gp.exportjar}"/>
      </classpath>
    </javac>
    <javac srcdir="${tool.sourcepath}" destdir="${tool.outputpath}" source="1.8" target="1.8" includeantruntime="false" encoding="windows-1252" excludes="**/nist/**">
      <classpath>
        <path refid="tool.compile.classpath"/>
        <pathelement location="${tool.outputpath}"/>
      </classpath>
    </javac>
  </target>

  <target name="openfips201-tool" depends="compile,tool-compile">
    <java classname="dev.mistial.tools.openfips201.OpenFips201Tool" fork="true" failonerror="true">
      <classpath refid="tool.runtime.classpath"/>
      <arg line="${args}"/>
    </java>
  </target>

  <target name="test">
    <antcall target="test-suite">
      <param name="vci.suite" value="CS2"/>
      <param name="test.reportpath" value="build/test-reports/CS2"/>
      <param name="attestation.enabled" value="true"/>
    </antcall>
    <antcall target="test-suite">
      <param name="vci.suite" value="CS7"/>
      <param name="test.reportpath" value="build/test-reports/CS7"/>
      <param name="attestation.enabled" value="true"/>
    </antcall>
    <antcall target="test-suite">
      <param name="vci.suite" value="CS2"/>
      <param name="test.reportpath" value="build/test-reports/CS2-no-attestation"/>
      <param name="attestation.enabled" value="false"/>
    </antcall>
    <antcall target="test-suite">
      <param name="vci.suite" value="CS7"/>
      <param name="test.reportpath" value="build/test-reports/CS7-no-attestation"/>
      <param name="attestation.enabled" value="false"/>
    </antcall>
  </target>

  <target name="test-suite" depends="compile-cap,test-compile">
    <mkdir dir="${test.reportpath}" />

    <junitlauncher printSummary="true" haltOnFailure="true" excludeTags="slow">
      <classpath refid="test.runtime.classpath"/>
      <testclasses outputdir="${test.reportpath}">
        <fork>
          <sysproperty key="vci.suite" value="${vci.suite}"/>
          <sysproperty key="attestation.enabled" value="${attestation.enabled}"/>
        </fork>
        <fileset dir="${test.outputpath}">
          <include name="**/*Test.class"/>
        </fileset>
        <listener type="legacy-brief" sendSysOut="true" sendSysErr="true"/>
        <listener type="legacy-xml" sendSysOut="true" sendSysErr="true"/>
      </testclasses>
    </junitlauncher>
  </target>

  <target name="test-all">
    <antcall target="test-all-suite">
      <param name="vci.suite" value="CS2"/>
      <param name="test.reportpath" value="build/test-reports/CS2-all"/>
      <param name="attestation.enabled" value="true"/>
    </antcall>
    <antcall target="test-all-suite">
      <param name="vci.suite" value="CS7"/>
      <param name="test.reportpath" value="build/test-reports/CS7-all"/>
      <param name="attestation.enabled" value="true"/>
    </antcall>
    <antcall target="test-all-suite">
      <param name="vci.suite" value="CS2"/>
      <param name="test.reportpath" value="build/test-reports/CS2-no-attestation-all"/>
      <param name="attestation.enabled" value="false"/>
    </antcall>
    <antcall target="test-all-suite">
      <param name="vci.suite" value="CS7"/>
      <param name="test.reportpath" value="build/test-reports/CS7-no-attestation-all"/>
      <param name="attestation.enabled" value="false"/>
    </antcall>
  </target>

  <target name="test-all-suite" depends="compile-cap,test-compile">
    <mkdir dir="${test.reportpath}" />

    <junitlauncher printSummary="true" haltOnFailure="true">
      <classpath refid="test.runtime.classpath"/>
      <testclasses outputdir="${test.reportpath}">
        <fork>
          <sysproperty key="vci.suite" value="${vci.suite}"/>
          <sysproperty key="attestation.enabled" value="${attestation.enabled}"/>
        </fork>
        <fileset dir="${test.outputpath}">
          <include name="**/*Test.class"/>
        </fileset>
        <listener type="legacy-brief" sendSysOut="true" sendSysErr="true"/>
        <listener type="legacy-xml" sendSysOut="true" sendSysErr="true"/>
      </testclasses>
    </junitlauncher>
  </target>

  <target name="coverage" depends="compile,test-compile">
    <mkdir dir="${test.reportpath}" />
    <mkdir dir="${coverage.outputpath}" />

    <taskdef uri="antlib:org.jacoco.ant"
             resource="org/jacoco/ant/antlib.xml"
             classpathref="jacoco.ant.classpath" />

    <!-- Instrument before jCardEngine transforms applet classes in its simulator class loader. -->
    <jacoco:instrument destdir="${coverage.instrumented}">
      <fileset dir="${test.outputpath}">
        <include name="com/makina/security/openfips201/*.class" />
      </fileset>
    </jacoco:instrument>

    <jacoco:agent property="jacoco.agent.vmparam"
                  destfile="${coverage.execfile}"
                  excludes="com.makina.security.openfips201.*"
                  append="false" />

    <java classname="org.junit.platform.console.ConsoleLauncher" fork="true" failonerror="true">
      <classpath>
        <pathelement location="${coverage.instrumented}" />
        <path refid="test.runtime.classpath"/>
      </classpath>
      <jvmarg value="${jacoco.agent.vmparam}" />
      <arg value="execute" />
      <arg value="--exclude-tag" />
      <arg value="slow" />
      <arg value="--select-package" />
      <arg value="com.makina.security.openfips201" />
      <arg value="--select-package" />
      <arg value="dev.mistial.tests.openfips201" />
      <arg value="--select-package" />
      <arg value="dev.mistial.tools.openfips201" />
    </java>

    <jacoco:report>
      <executiondata>
        <file file="${coverage.execfile}" />
      </executiondata>
      <structure name="OpenFIPS201">
        <classfiles>
          <fileset dir="${test.outputpath}">
            <include name="com/makina/security/openfips201/*.class" />
          </fileset>
        </classfiles>
        <sourcefiles encoding="windows-1252">
          <fileset dir="${build.sourcepath}">
            <include name="**/*.java" />
          </fileset>
        </sourcefiles>
      </structure>
      <xml destfile="${coverage.xmlfile}" />
      <html destdir="${coverage.htmlpath}" />
    </jacoco:report>

    <mkdir dir="${coverage.outputpath}/tools" />
    <javac srcdir="build/tools"
           destdir="${coverage.outputpath}/tools"
           source="1.8"
           target="1.8"
           includeantruntime="false"
           includes="CoverageGate.java" />
    <java classname="CoverageGate" fork="true" failonerror="true">
      <classpath>
        <pathelement location="${coverage.outputpath}/tools" />
      </classpath>
      <arg value="${coverage.xmlfile}" />
      <arg value="${coverage.minimum.openfips201.line}" />
    </java>

  </target>

  <target name="all" depends="clean,compile,doc"/>
  
</project>
